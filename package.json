{
  "name": "@mui-solid/material",
  "version": "9.5.0-solid.0",
  "description": "Material UI for SolidJS 2",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "browser": "./dist/index.js",
      "node": "./dist/server/index.js",
      "import": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/theme.d.ts",
      "solid": "./src/theme.tsx",
      "browser": "./dist/theme.js",
      "node": "./dist/server/theme.js",
      "import": "./dist/theme.js"
    },
    "./colors": {
      "types": "./dist/colors/index.d.ts",
      "import": "./dist/colors/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "solid": "./src/icons/*.tsx",
      "browser": "./dist/icons/*.js",
      "node": "./dist/server/icons/*.js",
      "import": "./dist/icons/*.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "solid": "./src/*/index.ts",
      "browser": "./dist/*/index.js",
      "node": "./dist/server/*/index.js",
      "import": "./dist/*/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "solid": "./src/icons/index.ts",
      "browser": "./dist/icons/index.js",
      "node": "./dist/server/icons/index.js",
      "import": "./dist/icons/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "solid": "./src/utils.ts",
      "browser": "./dist/utils.js",
      "node": "./dist/server/utils.js",
      "import": "./dist/utils.js"
    },
    "./styles/*": {
      "types": "./dist/*/index.d.ts",
      "solid": "./src/*/index.ts",
      "browser": "./dist/*/index.js",
      "node": "./dist/server/*/index.js",
      "import": "./dist/*/index.js"
    },
    "./utils/*": {
      "types": "./dist/*/index.d.ts",
      "solid": "./src/*/index.ts",
      "browser": "./dist/*/index.js",
      "node": "./dist/server/*/index.js",
      "import": "./dist/*/index.js"
    },
    "./colors/*": {
      "types": "./dist/colors/*.d.ts",
      "import": "./dist/colors/*.js"
    },
    "./styles/colorManipulator": {
      "types": "./dist/color-manipulator.d.ts",
      "solid": "./src/color-manipulator.ts",
      "import": "./dist/color-manipulator.js"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "size": "node scripts/bundle-report.mjs",
    "build:demo": "vite build"
  },
  "peerDependencies": {
    "solid-js": "2.0.0-rc.14",
    "@solidjs/web": "2.0.0-rc.14"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@floating-ui/dom": "^1.7.4",
    "stylis": "^4.3.6",
    "@emotion/serialize": "^1.3.3"
  },
  "devDependencies": {
    "solid-js": "2.0.0-rc.14",
    "@solidjs/web": "2.0.0-rc.14",
    "@solidjs/vite-plugin": "3.0.0-next.49",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "@babel/core": "^7.28.4",
    "@types/node": "^24.6.0",
    "@fontsource/roboto": "^5.2.8",
    "@types/stylis": "^4.2.7",
    "@solidjs/babel-plugin": "2.0.0-rc.14"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
